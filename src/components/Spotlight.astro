---
import { Image } from 'astro:assets';
import InsimulArchitecture from './InsimulArchitecture.astro';
import { spotlight } from '../data/projects';
import editor from '../assets/insimul-editor.png';

const sources = { editor } as const;
const { project, eyebrow, headline, dissertation, degree, paragraphs, figures } = spotlight;
---

<section class="spot">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>

    <div class="spot__top">
      <h2 class="spot__name">{project.name}</h2>
      <span class="spot__kind">{project.kind}</span>
    </div>

    <p class="spot__headline">{headline}</p>
    <p class="spot__diss"><cite>{dissertation}</cite></p>
    <p class="spot__degree">{degree}</p>

    <div class="spot__body">
      <div class="spot__prose">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <aside class="spot__side">
        <div class="spot__stack">
          <p class="spot__stack-label">Built with</p>
          <ul class="tag-row">
            {project.stack.map((s) => <li class="tag">{s}</li>)}
          </ul>
        </div>

        <div class="figs">
          {
            figures.map((f) => (
              <figure class="fig">
                <Image
                  class="fig__img"
                  src={sources[f.src as keyof typeof sources]}
                  alt={f.caption}
                  widths={[420, 840]}
                  sizes="(max-width: 52rem) 92vw, 24rem"
                  loading="lazy"
                />
                <figcaption class="fig__cap">
                  <span class="fig__credit">{f.label}</span>
                  {f.caption}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </aside>
    </div>

    <InsimulArchitecture />
  </div>
</section>

<style>
  .spot {
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }

  .spot__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
  }

  .spot__name {
    font-family: var(--font-mono);
    font-size: clamp(1.9rem, 5vw, 2.9rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .spot__kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .spot__headline {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.2vw, 1.9rem);
    line-height: 1.25;
    letter-spacing: -0.012em;
    margin-top: 0.85rem;
    max-width: 34ch;
    text-wrap: balance;
  }

  .spot__diss {
    margin-top: 0.9rem;
    font-size: 0.95rem;
  }

  .spot__diss cite {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--text-muted);
  }

  .spot__degree {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin-top: 0.2rem;
  }

  .spot__body {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(min(15rem, 100%), 1fr);
    gap: 2.5rem 3.5rem;
    margin-top: 2.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border);
  }

  .spot__prose {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: var(--measure);
  }

  .spot__prose p {
    font-size: 1rem;
    color: var(--text-muted);
  }

  .spot__stack-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
  }

  /* --- figures from the dissertation --- */

  /* Sits in the side column under the stack, so the column already bounds it. */
  .figs {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .fig {
    margin: 0;
  }

  /* The screenshots are light-background UI; a surface panel keeps them from
     glaring against the dark theme. */
  .fig__img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
  }

  .fig__cap {
    margin-top: 0.65rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-faint);
  }

  .fig__credit {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-right: 0.5rem;
  }

  @media (max-width: 52rem) {
    .spot__body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
